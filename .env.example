# Email (SMTP) - used by app/api/contact/route.ts
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@safecertskillsltd.co.uk
SMTP_PASS=PUT_YOUR_SMTP_PASSWORD_HERE

# Sender identity shown in the email headers
# If you set FROM_EMAIL, it will be used as the From display name/address.
FROM_EMAIL=info@safecertskillsltd.co.uk

# Optional: explicit header email for SMTP_FROM_EMAIL (used to avoid issues with providers)
# FROM header will become: "SafeCert Skills" <SMTP_FROM_EMAIL>
SMTP_FROM_EMAIL=info@safecertskillsltd.co.uk

